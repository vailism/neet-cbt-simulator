# PostgreSQL Database Connection String
# Compatible with Neon, Supabase, Vercel Postgres, Railway, or local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neetcbt?schema=public"

# Google Gemini API Key (Required for AI question generation & independent verification)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Gemini Model Selection (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"
