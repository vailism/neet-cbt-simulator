# PostgreSQL Database Connection String (Neon Serverless Postgres)
# Pooled connection string (used at runtime by Next.js & PrismaClient)
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-8.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Direct unpooled connection string (used for Prisma migrations and db push)
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-sample.c-8.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Project & Branch Configuration
NEON_BRANCH="production"
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""

# NextAuth Secret
NEXTAUTH_SECRET="your-secret-key-here"

# Public Application Metadata
NEXT_PUBLIC_APP_NAME="NEET (UG) CBT Simulator"

# Google Gemini API Key (Required for AI question generation & independent verification)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# Gemini Model Selection (Optional, defaults to gemini-3.5-flash-lite)
GEMINI_MODEL="gemini-3.5-flash-lite"

APP_PASSCODE="neet2027"
