generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum SubjectType {
  PHYSICS
  CHEMISTRY
  BOTANY
  ZOOLOGY
}

enum Difficulty {
  EASY
  MODERATE
  DIFFICULT
}

enum ExamMode {
  FULL_MOCK
  PRACTICE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  TIMED_OUT
}

enum QuestionStatus {
  NOT_VISITED
  NOT_ANSWERED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_AND_MARKED
}

enum QuestionSource {
  OFFICIAL_PYQ
  NCERT_PRACTICE
  AI_GENERATED
  ADVANCED_APPLICATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

model Candidate {
  id          String        @id @default(uuid())
  rollNumber  String        @unique
  name        String
  email       String?
  avatarUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attempts    ExamAttempt[]

  @@index([rollNumber])
}

model Subject {
  id        String      @id @default(uuid())
  code      SubjectType @unique
  name      String
  order     Int         @default(0)
  chapters  Chapter[]
  questions Question[]
}

model Chapter {
  id        String     @id @default(uuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  questions Question[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

model Question {
  id                 String             @id @default(uuid())
  subjectId          String
  subject            Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterId          String?
  chapter            Chapter?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic              String?
  statement          String             @db.Text
  imageUrl           String?
  option1            String             @db.Text
  option2            String             @db.Text
  option3            String             @db.Text
  option4            String             @db.Text
  correctAnswer      Int                // 1, 2, 3, or 4
  explanation        String             @db.Text
  difficulty         Difficulty         @default(MODERATE)
  questionSource     QuestionSource     @default(NCERT_PRACTICE)
  source             String?
  sourceYear         Int?
  sourcePaper        String?
  syllabusVersion    String             @default("NMC_NEET_2027")
  verificationStatus VerificationStatus @default(VERIFIED)
  duplicateHash      String?
  rejectionReason    String?
  reviewerNotes      String?
  verifiedAt         DateTime?
  verifiedBy         String?
  previousYear       String?            // e.g. "NEET 2023", "NEET 2022"
  isVerifiedPYQ      Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attemptItems       AttemptQuestion[]
  mockPaperItems     MockPaperQuestion[]

  @@index([subjectId])
  @@index([chapterId])
  @@index([difficulty])
  @@index([verificationStatus])
  @@index([questionSource])
  @@index([duplicateHash])
  @@index([isVerifiedPYQ])
}

model ExamConfiguration {
  id                   String        @id @default(uuid())
  name                 String
  code                 String        @unique
  durationMinutes      Int           @default(180)
  totalQuestions       Int           @default(180)
  physicsQuestions     Int           @default(45)
  chemistryQuestions   Int           @default(45)
  botanyQuestions      Int           @default(45)
  zoologyQuestions     Int           @default(45)
  marksPerCorrect      Int           @default(4)
  marksPerIncorrect    Int           @default(-1)
  marksPerUnanswered   Int           @default(0)
  easyPercent          Int           @default(30)
  moderatePercent      Int           @default(50)
  difficultPercent     Int           @default(20)
  isDefault            Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  attempts             ExamAttempt[]
}

model MockPaper {
  id                 String              @id @default(uuid())
  paperNumber        Int                 @unique // 1 to 100
  code               String              @unique // e.g. "MOCK_001"
  title              String              // e.g. "NEET (UG) Full Mock Test 001"
  description        String?
  durationMinutes    Int                 @default(180)
  totalQuestions     Int                 @default(180)
  physicsCount       Int                 @default(45)
  chemistryCount     Int                 @default(45)
  botanyCount        Int                 @default(45)
  zoologyCount       Int                 @default(45)
  easyCount          Int                 @default(54)
  moderateCount      Int                 @default(90)
  difficultCount     Int                 @default(36)
  randomSeed         String
  syllabusVersion    String              @default("NMC_NEET_2027")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paperQuestions     MockPaperQuestion[]
  attempts           ExamAttempt[]

  @@index([paperNumber])
  @@index([code])
}

model MockPaperQuestion {
  id                     String      @id @default(uuid())
  mockPaperId            String
  mockPaper              MockPaper   @relation(fields: [mockPaperId], references: [id], onDelete: Cascade)
  questionId             String
  question               Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionOrder          Int         // 1 to 180
  subjectCode            SubjectType
  optionAMapping         Int         @default(1) // Original option number (1..4)
  optionBMapping         Int         @default(2)
  optionCMapping         Int         @default(3)
  optionDMapping         Int         @default(4)
  shuffledCorrectAnswer  Int         @default(1) // 1..4 in shuffled option order
  createdAt              DateTime    @default(now())

  @@unique([mockPaperId, questionOrder])
  @@index([mockPaperId])
  @@index([questionId])
}

model ExamAttempt {
  id                  String             @id @default(uuid())
  candidateId         String
  candidate           Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  configId            String?
  config              ExamConfiguration? @relation(fields: [configId], references: [id], onDelete: SetNull)
  mockPaperId         String?
  mockPaper           MockPaper?         @relation(fields: [mockPaperId], references: [id], onDelete: SetNull)
  attemptNumber       Int                @default(1)
  mode                ExamMode           @default(FULL_MOCK)
  title               String             @default("NEET (UG) CBT Full Mock Examination")
  subjectFilter       String?            // For practice mode
  chapterFilter       String?            // For practice mode
  status              AttemptStatus      @default(IN_PROGRESS)
  startedAt           DateTime           @default(now())
  expiresAt           DateTime
  submittedAt         DateTime?
  totalScore          Int?
  maxScore            Int                @default(720)
  correctCount        Int?
  incorrectCount      Int?
  unattemptedCount    Int?
  accuracy            Float?
  timeSpentSeconds    Int?
  physicsScore        Int?
  chemistryScore      Int?
  botanyScore         Int?
  zoologyScore        Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  questions           AttemptQuestion[]

  @@index([candidateId])
  @@index([status])
  @@index([startedAt])
  @@index([mockPaperId])
}

model AttemptQuestion {
  id               String         @id @default(uuid())
  attemptId        String
  attempt          ExamAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionOrder    Int
  subjectCode      SubjectType
  selectedOption   Int?           // 1, 2, 3, 4 or null
  isMarkedForReview Boolean       @default(false)
  status           QuestionStatus @default(NOT_VISITED)
  timeSpentSeconds Int            @default(0)
  isCorrect        Boolean?
  marksAwarded     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([attemptId, questionOrder])
  @@index([attemptId])
  @@index([questionId])
  @@index([status])
}

model AIGenerationBatch {
  id             String      @id @default(uuid())
  subjectCode    SubjectType
  chapterName    String?
  topic          String?
  targetCount    Int
  generatedCount Int         @default(0)
  status         String      @default("PENDING")
  modelName      String?     @default("gemini-2.5-flash")
  promptUsed     String?     @db.Text
  errorLog       String?     @db.Text
  rawResponse    String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
